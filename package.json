{
  "name": "gobike-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <23",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "ngc -p tsconfig.check.json && tsc -p tsconfig.spec.json --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run build",
    "prepare": "husky",
    "check": "ngc -p tsconfig.check.json"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@microsoft/signalr": "^8.0.29",
    "bootstrap": "^5.3.8",
    "leaflet": "1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.20",
    "@angular/cli": "^18.2.20",
    "@angular/compiler-cli": "^18.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "1.9",
    "angular-eslint": "^18.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.72.1"
  }
}
